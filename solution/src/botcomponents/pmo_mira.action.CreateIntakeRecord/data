          capability: List
        type: String

  dynamicOutputSchema:
    kind: Record
    properties:
      pmo_projectrequestid:
        displayName: Record ID
        description: Unique identifier for entity instances
        order: 0
        type: String

      pmo_name:
        displayName: Name
        order: 1
        type: String

      pmo_submissiontext:
        displayName: Submission Text
        order: 2
        type: String

      pmo_status:
        displayName: Request Status
        order: 3
        dynamicValuesConfig:
          capability: List
        type: Number

outputMode: All
