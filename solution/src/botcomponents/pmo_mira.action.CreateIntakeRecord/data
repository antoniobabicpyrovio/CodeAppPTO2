  connectionProperties:
    usageDescription: Please sign in to allow Mira to submit a PMO intake request on your behalf.
    mode: Invoker

  operationId: CreateRecordWithOrganization
  dynamicInputSchema:
    properties:
      entityName:
        displayName: Table name
        description: Choose a table
        isRequired: true
        order: 1
        dynamicValuesConfig:
          capability: List
        type: String

      item:
        displayName: Row Item
        description: Row to create
        isRequired: true
        order: 2
        type:
          kind: Record
          properties:
            pmo_name:
              displayName: Name
              isRequired: true
              order: 0
              type: String

            pmo_submissiontext:
              displayName: Submission Text
              order: 1
              type: String

            pmo_status:
              displayName: Request Status
              isRequired: true
              order: 2
              dynamicValuesConfig:
                capability: List
              type: Number

      organization:
